{
  "name": "vite-react-ts-starter",
  "version": "0.1.0",
  "homepage": "https://github.com/zhixiangyao/vite-react-ts-starter",
  "license": "MIT",
  "author": "zhixiangyao <blueskyzx@icloud.com> <https://github.com/zhixiangyao>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhixiangyao/vite-react-ts-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm typecheck && vite build",
    "preview": "pnpm build && vite preview",
    "preview:dist": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "lint-staged": "lint-staged",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "react-router": "8.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "simple-git-hooks": "2.13.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-compression": "0.5.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,jsx,ts,mts,tsx}": [
      "pnpm lint:check"
    ],
    "**/*.{js,cjs,mjs,jsx,ts,mts,tsx,html,md,json,css,yaml,yml}": [
      "pnpm fmt:check"
    ]
  },
  "engines": {
    "node": ">=26.7.0",
    "pnpm": ">=11.20.0"
  }
}
